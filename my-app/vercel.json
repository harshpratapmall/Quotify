{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/share/:token",
      "destination": "/index.html"
    },
    {
      "source": "/api/blob/upload",
      "destination": "/api/blob-upload"
    },
    {
      "source": "/api/:path*",
      "destination": "https://quotify-t879.onrender.com/api/:path*"
    }
  ]
}
