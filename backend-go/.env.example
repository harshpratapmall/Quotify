# Required: the ID from the Google Sheets URL, not the sheet/tab name.
GOOGLE_SHEET_ID=your-google-spreadsheet-id
# Use a local credential file during development. Do not commit this file.
GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json
# Use a long, random value in every environment.
AUTH_SESSION_SECRET=replace-with-a-long-random-secret
# Set true only when serving the API via HTTPS. Hosted browser traffic is
# proxied through Vercel's same-origin /api path, so production cookies use
# Secure, HttpOnly, and SameSite=Lax.
COOKIE_SECURE=false
# Optional comma-separated override for approved browser origins.
CORS_ALLOWED_ORIGINS=
# Optional Google Sheet tab name overrides for payroll records and audit data.
SHEET_TAB_EMPLOYEES=
SHEET_TAB_EMPLOYEE_PAYROLL=
SHEET_TAB_EMPLOYEE_PAYROLL_ENTRIES=
SHEET_TAB_EMPLOYEE_PAYROLL_STATES=
SHEET_TAB_EMPLOYEE_PAYROLL_ACTIVITY=
# Local-only diagnostics. Never enable this in a shared environment.
AUTH_DEBUG=false
# Optional server-side API telemetry. Use the PostHog project API key; do not
# put this value in frontend configuration.
POSTHOG_API_KEY=
# Optional for self-hosted PostHog. Defaults to https://us.i.posthog.com.
POSTHOG_HOST=
